# Test configuration, loaded by tests/conftest.py (copy to .env and adjust).
# Values already set in the real environment take precedence over this file.

# Rootless podman socket, so testcontainers can start Postgres.
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# Often required with rootless podman (the Ryuk reaper container needs a privileged socket).
TESTCONTAINERS_RYUK_DISABLED=true
